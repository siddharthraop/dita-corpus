                  <dlentry>
                    <dt>
                      <codeph>STATE_UNSPECIFIED</codeph>
                    </dt>
                    <dd>TPU node state is not known/set.</dd>
                  </dlentry>
                  <dlentry>
                    <dt>
                      <codeph>CREATING</codeph>
                    </dt>
                    <dd>TPU node is being created.</dd>
                  </dlentry>
                  <dlentry>
                    <dt>
                      <codeph>READY</codeph>
                    </dt>
                    <dd>TPU node has been created.</dd>
                  </dlentry>
                  <dlentry>
                    <dt>
                      <codeph>RESTARTING</codeph>
                    </dt>
                    <dd>TPU node is restarting.</dd>
                  </dlentry>
                  <dlentry>
                    <dt>
                      <codeph>REIMAGING</codeph>
                    </dt>
                    <dd>TPU node is undergoing reimaging.</dd>
                  </dlentry>
                  <dlentry>
                    <dt>
                      <codeph>DELETING</codeph>
                    </dt>
                    <dd>TPU node is being deleted.</dd>
                  </dlentry>
                  <dlentry>
                    <dt>
                      <codeph>REPAIRING</codeph>
                    </dt>
                    <dd>TPU node is being repaired and may be unusable. Details can be found in the 'help_description' field.</dd>
                  </dlentry>
                  <dlentry>
                    <dt>
                      <codeph>STOPPED</codeph>
                    </dt>
                    <dd>TPU node is stopped.</dd>
                  </dlentry>
                  <dlentry>
                    <dt>
                      <codeph>STOPPING</codeph>
                    </dt>
                    <dd>TPU node is currently stopping.</dd>
                  </dlentry>
                  <dlentry>
                    <dt>
                      <codeph>STARTING</codeph>
                    </dt>
                    <dd>TPU node is currently starting.</dd>
                  </dlentry>
                  <dlentry>
                    <dt>
                      <codeph>PREEMPTED</codeph>
