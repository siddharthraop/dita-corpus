<map id="gemma-evidence" xml:lang="en-US">
  <title>Gemma model documentation as regulatory evidence (sample set)</title>
  <topicmeta>
    <shortdesc>Requirement topics for EU AI Act Annexes XI and XII and four NIST AI RMF subcategories, evidence topics
      adapted from the Gemma 4 and Gemma 3 model cards, and a relationship table that traces each requirement to its
      evidence. A requirement row with an empty model cell is a documentation gap.</shortdesc>
    <data name="licence" value="Evidence topics: CC BY 4.0, adapted from Google model cards and modified. Requirement topics: plain-language paraphrase." href="https://developers.google.com/site-policies" scope="external" format="html"/>
  </topicmeta>
  <mapref href="keys/gemma-keys.ditamap" processing-role="resource-only"/>
  <mapref href="gemma-scheme.ditamap" type="subjectScheme" processing-role="resource-only"/>
